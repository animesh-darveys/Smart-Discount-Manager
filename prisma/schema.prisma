generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline             Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName            String?
  lastName             String?
  email                String?
  accountOwner        Boolean   @default(false)
  locale               String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DiscountOffer {
  id                  String         @id @default(cuid())

  shop                String

  // General
  title               String
  description         String?

  // Shopify Discount
  shopifyDiscountId   String?        @unique
  discountCode        String         @unique
  source              DiscountSource @default(MANUAL)

  // Discount Configuration
  discountCategory    String         @default("ORDER")
  discountType        String
  discountValue       Float
  minimumPurchase     Float?

  // Applies To
  appliesTo           String
  selectedProducts    Json?
  selectedCollections Json?

  // Customer Eligibility
  customerEligibility String
  customerIds         Json?
  limitPerCustomer    Boolean        @default(false)

  // Usage
  usageLimit          Int?

  // Timeline
  startDate           DateTime
  endDate             DateTime?

  // AUTO_REWARD / Cashback Information
  orderId             String?
  orderName           String?
  customerId          String?
  customerName        String?
  customerEmail       String?
  cashbackAmount      Float?
  deliveredAt         DateTime?
  generatedAt         DateTime?
  emailSentAt         DateTime?

  // Status
  status              String         @default("active")

  // Audit
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([shop, orderId])
  @@index([shop])
}

enum DiscountSource {
  MANUAL
  AUTO_REWARD
}