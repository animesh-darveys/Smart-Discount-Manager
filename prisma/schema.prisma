// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}


model DiscountOffer {
  @@index([shop])

  id                  String   @id @default(cuid())

  // Multi-store support
  shop                String

  title               String
  description         String?

  discountCode        String   @unique

  discountCategory    String   @default("ORDER")
  discountType        String
  discountValue       Float

  minimumPurchase     Float?

  appliesTo           String

  selectedProducts    Json?
  selectedCollections Json?

  customerEligibility String
  customerIds         Json?

  startDate           DateTime
  endDate             DateTime?

  usageLimit          Int?
  limitPerCustomer    Boolean  @default(false)

  status              String   @default("active")

  shopifyDiscountId   String? @unique
  source              DiscountSource @default(MANUAL)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Reward {
  id              String   @id @default(cuid())

  // Multi-store support
  shop            String

  // Shopify IDs
  orderId         String
  orderName       String
  customerId      String

  // Generated Discount
  discountOfferId String?
  discountCode    String?
  cashbackAmount Decimal @db.Decimal(10,2)

  // Processing
  status          RewardStatus @default(PENDING)

  // Timeline
  deliveredAt     DateTime
  eligibleAt      DateTime
  generatedAt     DateTime?
  emailSentAt     DateTime?

  // Error handling
  retryCount      Int @default(0)
  errorMessage    String?

  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
  @@unique([shop, orderId])
}

enum DiscountSource {
  MANUAL
  AUTO_REWARD
}
enum RewardStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}