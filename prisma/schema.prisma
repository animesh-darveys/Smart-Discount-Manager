generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model DiscountOffer {
  id                  String         @id @default(cuid())

  // Multi-store support
  shop                String

  // General
  title               String
  description         String?

  // Shopify Discount
  shopifyDiscountId   String?        @unique
  discountCode        String         @unique
  source              DiscountSource @default(MANUAL)

  // Discount Configuration
  discountCategory    String         @default("ORDER")
  discountType        String
  discountValue       Float
  minimumPurchase     Float?

  // Applies To
  appliesTo           String
  selectedProducts    Json?
  selectedCollections Json?

  // Customer Eligibility
  customerEligibility String
  customerIds         Json?
  limitPerCustomer    Boolean        @default(false)

  // Usage
  usageLimit          Int?

  // Timeline
  startDate           DateTime
  endDate             DateTime?

  // Status
  status              String         @default("active")

  // Audit
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([shop])
}

model Reward {
  id              String       @id @default(cuid())

  // Multi-store support
  shop            String

  // Shopify Order
  orderId         String
  orderName       String

  // Customer
  customerId      String
  customerEmail   String
  customerName    String?

  // Generated Discount
  discountOfferId String?
  discountCode    String?
  cashbackAmount  Decimal      @db.Decimal(10, 2)

  // Processing
  status          RewardStatus @default(PENDING)

  // Timeline
  deliveredAt     DateTime
  eligibleAt      DateTime
  generatedAt     DateTime?
  emailSentAt     DateTime?

  // Error Handling
  retryCount      Int          @default(0)
  errorMessage    String?

  // Audit
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([shop, orderId])
  @@index([shop])
}

enum DiscountSource {
  MANUAL
  AUTO_REWARD
}

enum RewardStatus {
  PENDING
  COMPLETED
  CANCELLED
  FAILED
}
